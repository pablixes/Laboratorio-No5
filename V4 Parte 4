void PL1(uint8_t valor)
{
    // Primero apagar los cuatro LEDs
    HAL_GPIO_WritePin(LEDR1_GPIO_Port, LEDR1_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(LEDR2_GPIO_Port, LEDR2_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(LEDR3_GPIO_Port, LEDR3_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(LEDR4_GPIO_Port, LEDR4_Pin, GPIO_PIN_RESET);

    // Encender el LED correspondiente a la posición
    switch (valor)
    {
        case 0:
            // Todos apagados
            break;

        case 1:
            HAL_GPIO_WritePin(
                LEDR1_GPIO_Port,
                LEDR1_Pin,
                GPIO_PIN_SET
            );
            break;

        case 2:
            HAL_GPIO_WritePin(
                LEDR2_GPIO_Port,
                LEDR2_Pin,
                GPIO_PIN_SET
            );
            break;

        case 3:
            HAL_GPIO_WritePin(
                LEDR3_GPIO_Port,
                LEDR3_Pin,
                GPIO_PIN_SET
            );
            break;

        case 4:
            HAL_GPIO_WritePin(
                LEDR4_GPIO_Port,
                LEDR4_Pin,
                GPIO_PIN_SET
            );
            break;
    }
}

