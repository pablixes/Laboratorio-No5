void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    uint32_t current_time = HAL_GetTick();

    // Ignorar botones si la carrera está bloqueada
    if (car == 0)
    {
        return;
    }

    // Jugador 1
    if ((GPIO_Pin == B1_Pin) &&
        (current_time - last_irq_time_p1 >= 200))
    {
        last_irq_time_p1 = current_time;

        if (contp1 < 4)
        {
            contp1++;
        }

        if (contp1 == 4)
        {
            ganador = 1;
            car = 0; // Bloquear inmediatamente ambos botones
        }
    }

    // Jugador 2
    if ((GPIO_Pin == B2_Pin) &&
        (current_time - last_irq_time_p2 >= 200))
    {
        last_irq_time_p2 = current_time;

        if (contp2 < 4)
        {
            contp2++;
        }

        if (contp2 == 4)
        {
            ganador = 2;
            car = 0; // Bloquear inmediatamente ambos botones
        }
    }
}
